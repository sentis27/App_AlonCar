          "app/src/components/costControl/CostControlMaterialsTable.jsx",
          "app/src/components/costControl/CostControlLaborOnlyPanel.jsx"
        ]
      }
    ]
  },
  "diffGuardPatterns": [
    { "label": "encabezado de columna (<th>)", "pattern": "<th\\b" },
    { "label": "apertura de modal (isOpen: true)", "pattern": "\\bisOpen\\s*:\\s*true\\b" },
    { "label": "tooltip flotante de OT", "pattern": "\\b(?:formatWorkOrderTooltip|formatWorkOrderTooltipCanonical|CanonicalOtBadge)\\b" },
    { "label": "transición de estado (status:)", "pattern": "\\bstatus\\s*:\\s*['\"][A-Z_.\\s?]+['\"]" }
  ],
  "architectureBoundaries": {
    "banLibUiImports": true,
    "banDirectUiRepositoryImports": {
      "enabled": true,
      "allowlist": [
        "app/src/components/compras/NewMaterialModal.jsx",
        "app/src/pages/Login.jsx"
      ]
    },
    "banReactClassComponents": {
      "enabled": true,
      "allowlist": [
        "app/src/components/canonical/RouteErrorBoundary.jsx"
      ]
    },
    "banUnsafeOnBlur": {
      "enabled": true,
      "allowlist": []
    },
    "requireAuditInMutatingServices": {
      "enabled": true,
      "allowlist": [
        "app/src/services/adminGovernanceService.js",
        "app/src/services/personalTarifarioService.js"
      ]
    },
    "banCrossModuleComponentImports": {
      "enabled": true,
      "sharedComponentDirs": ["canonical"],
      "allowedTargets": [
        "app/src/components/workOrders/WorkOrderSelectorWithHover"
      ],
      "allowlist": [
        "app/src/components/admin/AdminAlertsCompliancePanel.jsx",
        "app/src/components/tesoreria/contratados/TesoreriaContratadosModals.jsx"
      ]
    }
  },
  "where": {
    "navigationCatalogPath": "app/src/lib/navigationCatalog.js",
    "moduleAliases": {
      "dashboard": ["Dashboard", "dashboard"],
      "ots": ["WorkOrders", "workOrders", "workItems", "otAbc"],
      "horas": ["LaborLogs", "labor", "laborLogs"],
      "panol": ["Panol", "panol", "materials", "inventoryTransactions", "gasMovements", "stockControl"],
      "terceros": ["Terceros", "terceros", "thirdParty", "prcRegistry"],
      "compras": ["Compras", "compras", "purchaseOrders", "suppliers"],
      "personal": ["Personal", "personal", "workers", "rateCards"],
      "tesoreria": ["Tesoreria", "tesoreria", "contractorCc", "contractorDeductions", "contractorLedger"],
      "barcos": ["Ships", "ships", "shipStays", "owners"],
      "resumen-gerencial": ["ResumenGerencial", "resumenGerencial", "managerialSummary", "billing"],
      "control-gastos": ["ControlGastos", "costControl"],
      "admin": ["AdminDashboard", "admin", "AdminAuditLedger", "auditLogs", "organizationRoles"]
    }
  }
}
