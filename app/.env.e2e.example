# Copiar este archivo a `app/.env.e2e.local` (ignorado por Git) y completar credenciales QA.
E2E_BASE_URL=http://127.0.0.1:5173
E2E_EMAIL=qa@tu-empresa.com
E2E_PASSWORD=reemplazar_con_clave_qa
# Fusible Opción A: false bloquea escrituras (POST/PUT/PATCH/DELETE) contra Supabase durante pruebas.
E2E_ALLOW_WRITES=false
# Opcional: dejar vacío para Chromium de Playwright, o "chrome" / "msedge" si querés usar el del sistema.
E2E_BROWSER_CHANNEL=
